# Global leaderboard backend (Upstash Redis REST).
# Create a free Redis database at https://console.upstash.com, then copy its
# REST URL + token here. Required for /api/leaderboard to work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: point the static-data client at a running backend during dev.
# VITE_API_URL=http://localhost:8000
